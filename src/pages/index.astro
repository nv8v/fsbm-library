---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

type ModuleEntry = {
  id?: string;
  name: string;
  code?: string | null;
  description?: string | null;
  imageUrl?: string | null;
  driveUrl: string;
};
type SemesterEntry = {
  id?: string;
  number: number;
  label?: string;
  description?: string | null;
  imageUrl?: string | null;
  modules: ModuleEntry[];
};
type FiliereEntry = {
  id?: string;
  name: string;
  slug: string;
  description?: string | null;
  imageUrl?: string | null;
  semesters: SemesterEntry[];
};

const base = import.meta.env.BASE_URL;
const catalogueFiles = Object.values(
  import.meta.glob('../data/catalogue/*/catalogue.json', {
    eager: true,
    import: 'default',
  }),
) as FiliereEntry[];

for (const [fileIndex, filiere] of catalogueFiles.entries()) {
  if (!filiere.name?.trim() || !filiere.slug?.trim() || !Array.isArray(filiere.semesters)) {
    throw new Error(`Catalogue filière invalide (fichier n°${fileIndex + 1}) : name, slug et semesters sont requis.`);
  }
  for (const semester of filiere.semesters) {
    if (!Number.isInteger(semester.number) || semester.number < 1 || !Array.isArray(semester.modules)) {
      throw new Error(`Semestre invalide dans la filière « ${filiere.name} » : number et modules sont requis.`);
    }
    for (const module of semester.modules) {
      let validDriveFolder = false;
      try {
        const drive = new URL(module.driveUrl);
        validDriveFolder = drive.protocol === 'https:' &&
          drive.hostname === 'drive.google.com' &&
          /\/folders\/[^/?#]+/.test(drive.pathname) &&
          !drive.pathname.includes('REMPLACER_PAR_ID');
      } catch {
        validDriveFolder = false;
      }
      if (!module.name?.trim() || !validDriveFolder) {
        throw new Error(`Module invalide dans « ${filiere.name} » / semestre ${semester.number} : name et un lien HTTPS vers un dossier Google Drive sont requis.`);
      }
    }
  }
}

const filieres = catalogueFiles
  .map((filiere) => ({
    ...filiere,
    id: filiere.id || filiere.slug,
    semesters: [...(filiere.semesters || [])]
      .sort((a, b) => a.number - b.number)
      .map((semester) => ({
        ...semester,
        id: semester.id || `${filiere.slug}-s${semester.number}`,
        label: semester.label || `Semestre ${semester.number}`,
        modules: [...(semester.modules || [])].sort((a, b) =>
          a.name.localeCompare(b.name, 'fr'),
        ),
      })),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, 'fr'));

const catalogueJson = JSON.stringify(filieres).replace(/</g, '\\u003c');
---
<BaseLayout title="FSBM Library — Bibliothèque universitaire">
<div class="site-shell">
<header class="topbar">
  <a class="brand brand-image" href={base} aria-label="FSBM Library, accueil">
    <picture><img data-brand-logo src={`${base}fsbm-logo-dark-full.png`} alt="FSBM Library" /></picture>
  </a>
  <nav class="top-nav" aria-label="Navigation principale">
    <a href="#catalogue">Filières</a>
    <a href="#recherche">Recherche</a>
  </nav>
  <div class="top-actions">
    <ThemeToggle />
    <a class="github-link" href="https://github.com/nv8v" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.53v-2.07c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.71 1.15 1.71 1.15.99 1.7 2.6 1.21 3.23.93.1-.72.39-1.21.7-1.49-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.55 0c2.12-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.24-5.1 5.52.4.35.75 1.03.75 2.08V22c0 .29.2.63.76.52A11.1 11.1 0 0 0 12 .9Z"/></svg>
    </a>
  </div>
</header>
<main>
<section class="hero">
  <div class="hero-copy">
    <div class="eyebrow"><span class="status-dot"></span> FACULTÉ DES SCIENCES BEN M'SIK</div>
    <h1>Le savoir,<br />à portée de <em>clic.</em></h1>
    <p class="hero-description">Explorez les filières, semestres et modules. Retrouvez en un seul endroit les dossiers pédagogiques partagés par les enseignants.</p>
    <a class="primary-button" href="#catalogue">Explorer la bibliothèque ↗</a>
    <div class="hero-note"><span class="note-icon">✓</span> Accès libre aux dossiers Google Drive, sans compte étudiant.</div>
  </div>
  <div class="hero-art" aria-hidden="true">
    <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
    <div class="art-card card-back"><span>FSBM</span><i>01</i></div>
    <div class="art-card card-front"><div class="file-icon">DRIVE</div><div class="art-lines"><b></b><b></b><b></b></div><span class="art-card-caption">Ressources académiques</span></div>
    <div class="art-stamp">APPRENDRE<br />· PARTAGER ·</div>
  </div>
</section>

<section class="section-block" id="catalogue">
  <div class="section-heading">
    <div><div class="eyebrow">VOTRE PARCOURS</div><h2>Explorer les filières<span>.</span></h2></div>
    <p>Choisissez une filière, puis un semestre et un module pour accéder directement à son dossier Google Drive.</p>
  </div>
  <div id="catalogue-status" class="muted" role="status"></div>
  <div id="filiere-list" class="semester-grid"></div>
  <div id="hierarchy-panel" hidden>
    <div class="breadcrumb" id="catalogue-breadcrumb"></div>
    <div id="semester-list" class="semester-grid"></div>
    <div id="module-list" class="resource-results"></div>
  </div>
</section>

<section class="resource-search" id="recherche">
  <div class="section-heading">
    <div><div class="eyebrow">ACCÈS DIRECT</div><h2>Recherche globale<span>.</span></h2></div>
    <p>Recherchez une filière, un semestre, un module ou une description.</p>
  </div>
  <form id="search-form" class="search-form">
    <label class="search-field"><span class="sr-only">Rechercher</span><span aria-hidden="true">⌕</span><input id="search-query" type="search" minlength="2" placeholder="Nom d’une filière, d’un module…" /></label>
    <button class="primary-button" type="submit">Rechercher</button>
  </form>
  <div id="search-results" class="resource-results" aria-live="polite"></div>
</section>
</main>
<footer class="footer">
  <p class="footer-verse" dir="rtl">وَقُل رَّبِّ زِدْنِي عِلْمًا 🪻</p>
  <a class="footer-brand" href={base}>FSBM Library.</a>
  <span>Ressources académiques en accès libre.</span>
</footer>
</div>

<script type="application/json" id="catalogue-data" set:html={catalogueJson}></script>
<script>
  type ModuleEntry = { id?: string; name: string; code?: string | null; description?: string | null; imageUrl?: string | null; driveUrl: string };
  type SemesterEntry = { id: string; number: number; label: string; description?: string | null; imageUrl?: string | null; modules: ModuleEntry[] };
  type FiliereEntry = { id: string; name: string; slug: string; description?: string | null; imageUrl?: string | null; semesters: SemesterEntry[] };

  const dataElement = document.querySelector<HTMLScriptElement>('#catalogue-data');
  const filieres = JSON.parse(dataElement?.textContent || '[]') as FiliereEntry[];
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector);

  function makeCard(title: string, description: string | null | undefined, meta: string, onClick: () => void, image?: string | null) {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'semester-card hierarchy-card';
    if (image) {
      const img = document.createElement('img');
      img.src = image;
      img.alt = '';
      img.loading = 'lazy';
      button.append(img);
    }
    const name = document.createElement('span');
    name.className = 'semester-name';
    name.textContent = title;
    const detail = document.createElement('span');
    detail.className = 'semester-meta';
    detail.textContent = description || meta;
    button.append(name, detail);
    button.addEventListener('click', onClick);
    return button;
  }

  function setBreadcrumb(items: Array<{ label: string; action: () => void }>) {
    const element = $('#catalogue-breadcrumb');
    if (!element) return;
    element.replaceChildren();
    items.forEach((item, index) => {
      if (index) element.append(' / ');
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'text-link';
      button.textContent = item.label;
      button.addEventListener('click', item.action);
      element.append(button);
    });
  }

  function showFilieres() {
    const list = $('#filiere-list');
    const panel = $('#hierarchy-panel');
    if (!list || !panel) return;
    panel.hidden = true;
    list.hidden = false;
    list.replaceChildren();
    filieres.forEach((f) => list.append(makeCard(
      f.name, f.description, `${f.semesters.length} semestre(s)`,
      () => showSemesters(f), f.imageUrl,
    )));
  }

  function showSemesters(filiere: FiliereEntry) {
    const list = $('#filiere-list');
    const panel = $('#hierarchy-panel');
    const target = $('#semester-list');
    const moduleList = $('#module-list');
    if (!list || !panel || !target || !moduleList) return;
    list.hidden = true;
    panel.hidden = false;
    target.hidden = false;
    target.replaceChildren();
    moduleList.hidden = true;
    moduleList.replaceChildren();
    filiere.semesters.forEach((semester) => target.append(makeCard(
      semester.label, semester.description, `${semester.modules.length} module(s)`,
      () => showModules(filiere, semester), semester.imageUrl,
    )));
    if (!filiere.semesters.length) target.textContent = 'Aucun semestre publié pour cette filière.';
    setBreadcrumb([{ label: 'Toutes les filières', action: showFilieres }, { label: filiere.name, action: () => showSemesters(filiere) }]);
  }

  function showModules(filiere: FiliereEntry, semester: SemesterEntry) {
    const target = $('#module-list');
    const semesterList = $('#semester-list');
    if (!target || !semesterList) return;
    semesterList.hidden = true;
    target.hidden = false;
    target.replaceChildren();
    semester.modules.forEach((module) => {
      const card = document.createElement('a');
      card.className = 'resource-card module-drive-card';
      card.href = module.driveUrl;
      card.target = '_blank';
      card.rel = 'noopener noreferrer';
      if (module.imageUrl) {
        const img = document.createElement('img');
        img.src = module.imageUrl;
        img.alt = '';
        img.loading = 'lazy';
        card.append(img);
      }
      const heading = document.createElement('h3');
      heading.textContent = module.name + (module.code ? ` · ${module.code}` : '');
      const description = document.createElement('p');
      description.className = 'muted';
      description.textContent = module.description || 'Ouvrir le dossier pédagogique';
      const link = document.createElement('span');
      link.className = 'download-link';
      link.textContent = 'Ouvrir Google Drive ↗';
      card.append(heading, description, link);
      target.append(card);
    });
    if (!semester.modules.length) target.textContent = 'Aucun module dans ce semestre pour le moment.';
    setBreadcrumb([
      { label: 'Toutes les filières', action: showFilieres },
      { label: filiere.name, action: () => showSemesters(filiere) },
      { label: semester.label, action: () => showModules(filiere, semester) },
    ]);
  }

  function renderSearchResults(query: string) {
    const target = $('#search-results');
    if (!target) return;
    target.replaceChildren();
    if (query.length < 2) {
      target.textContent = 'Saisissez au moins deux caractères.';
      return;
    }
    const normalized = query.toLocaleLowerCase('fr');
    const results: Array<{ kind: string; title: string; description: string; meta: string; open?: () => void; driveUrl?: string }> = [];
    filieres.forEach((f) => {
      if (`${f.name} ${f.description || ''}`.toLocaleLowerCase('fr').includes(normalized)) {
        results.push({ kind: 'Filière', title: f.name, description: f.description || '', meta: 'Filière', open: () => showSemesters(f) });
      }
      f.semesters.forEach((s) => {
        if (`${s.label} ${s.description || ''}`.toLocaleLowerCase('fr').includes(normalized)) {
          results.push({ kind: 'Semestre', title: s.label, description: s.description || '', meta: `${f.name} · ${s.label}`, open: () => showModules(f, s) });
        }
        s.modules.forEach((m) => {
          if (`${m.name} ${m.code || ''} ${m.description || ''}`.toLocaleLowerCase('fr').includes(normalized)) {
            results.push({ kind: 'Module', title: m.name, description: m.description || '', meta: `${f.name} · ${s.label}`, driveUrl: m.driveUrl });
          }
        });
      });
    });
    if (!results.length) {
      target.textContent = 'Aucun résultat.';
      return;
    }
    results.forEach((result) => {
      const article = document.createElement('article');
      article.className = 'resource-card';
      const meta = document.createElement('div');
      meta.className = 'resource-meta';
      meta.textContent = result.meta;
      const heading = document.createElement('h3');
      heading.textContent = result.title;
      const description = document.createElement('p');
      description.className = 'muted';
      description.textContent = result.description;
      article.append(meta, heading, description);
      if (result.driveUrl) {
        const link = document.createElement('a');
        link.className = 'download-link';
        link.href = result.driveUrl;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Ouvrir Google Drive ↗';
        article.append(link);
      } else if (result.open) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'text-link';
        button.textContent = 'Explorer';
        button.addEventListener('click', () => {
          result.open?.();
          $('#catalogue')?.scrollIntoView({ behavior: 'smooth' });
        });
        article.append(button);
      }
      target.append(article);
    });
  }

  $('#search-form')?.addEventListener('submit', (event) => {
    event.preventDefault();
    const query = ($('#search-query') as HTMLInputElement | null)?.value.trim() || '';
    renderSearchResults(query);
  });

  const status = $('#catalogue-status');
  if (status) status.textContent = filieres.length ? '' : 'Aucune filière configurée. Ajoutez un fichier catalogue.json dans src/data/catalogue/.';
  showFilieres();
</script>
</BaseLayout>
