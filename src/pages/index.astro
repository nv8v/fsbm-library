---
import BaseLayout from '../layouts/BaseLayout.astro';
import SemesterGrid from '../components/SemesterGrid.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { programme, resourceTypes } from '../data/catalogue';
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <div class="site-shell">
    <header class="topbar"><a class="brand" href={base} aria-label="FSBM Library, accueil"><span class="brand-mark">F<span>.</span></span><span class="brand-name">FSBM <strong>Library</strong><small>BIBLIOTHÈQUE UNIVERSITAIRE</small></span></a><nav class="top-nav" aria-label="Navigation principale"><a href="#semestres">Semestres</a><a href="#ressources">Ressources</a><a href="#demande">Demander un document</a></nav><div class="top-actions"><ThemeToggle /><a class="admin-link" href={`${base}admin/`}>Administration <span aria-hidden="true">↗</span></a></div></header>
    <main>
      <section class="hero"><div class="hero-copy"><div class="eyebrow"><span class="status-dot"></span> FACULTÉ DES SCIENCES BEN M'SIK</div><h1>Le savoir,<br />à portée de <em>clic.</em></h1><p class="hero-description">Retrouvez les supports de cours, travaux dirigés, travaux pratiques et examens de votre parcours en Informatique Appliquée.</p><a class="primary-button" href="#semestres">Explorer la bibliothèque <span aria-hidden="true">↗</span></a><div class="hero-note"><span class="note-icon">✓</span> Consultation et téléchargement libres, sans compte étudiant.</div></div><div class="hero-art" aria-hidden="true"><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div><div class="art-card card-back"><span>FSBM</span><i>01</i></div><div class="art-card card-front"><div class="file-icon">PDF</div><div class="art-lines"><b></b><b></b><b></b></div><span class="art-card-caption">Ressources académiques</span></div><div class="art-stamp">APPRENDRE<br />· PARTAGER ·</div></div></section>
      <section class="programme-strip"><div><span class="strip-label">ÉTABLISSEMENT</span><strong>Faculté des Sciences Ben M'Sik</strong></div><div><span class="strip-label">FILIÈRE</span><strong>{programme.name}</strong></div><div><span class="strip-label">SEMESTRES</span><strong>S1 — S6</strong></div></section>
      <section class="section-block" id="semestres"><div class="section-heading"><div><div class="eyebrow">VOTRE PARCOURS</div><h2>Choisir un semestre<span>.</span></h2></div><p>Parcourez les modules et leurs documents, classés pour retrouver rapidement la bonne ressource.</p></div><SemesterGrid /></section>
      <section class="resource-search" id="ressources"><div class="section-heading"><div><div class="eyebrow">ACCÈS DIRECT</div><h2>Rechercher une ressource<span>.</span></h2></div><p>Un titre, une matière ou un type de document.</p></div><form id="search-form" class="search-form"><label class="search-field"><span class="sr-only">Rechercher</span><span aria-hidden="true">⌕</span><input id="search-query" type="search" placeholder="Ex. : algorithmique, base de données…" /></label><select id="search-type" aria-label="Type de ressource"><option value="">Tous les types</option>{resourceTypes.map(type=><option value={type}>{type}</option>)}</select><button class="primary-button" type="submit">Rechercher</button></form><div id="search-results" class="resource-results" aria-live="polite"><p class="muted">Saisissez un terme ou choisissez un type pour consulter le catalogue.</p></div></section>
      <section class="request-banner" id="demande"><div><div class="eyebrow">CONTRIBUER À LA BIBLIOTHÈQUE</div><h2>Un document vous manque ?</h2><p>Envoyez une demande à l’équipe de la bibliothèque. Aucun compte étudiant n’est nécessaire.</p><button class="outline-button" type="button" data-open-request>Faire une demande <span aria-hidden="true">↗</span></button></div><span class="request-icon" aria-hidden="true">＋</span></section>
      <dialog id="request-dialog" class="dialog"><form id="request-form" class="dialog-card"><div class="dialog-head"><div><div class="eyebrow">DEMANDE DE RESSOURCE</div><h2>Quel document recherchez-vous ?</h2></div><button class="icon-button" type="button" data-close-dialog aria-label="Fermer">×</button></div><label>Semestre<select name="semester"><option value="">Non précisé</option>{Array.from({length:6},(_,i)=><option value={i+1}>S{i+1}</option>)}</select></label><label>Module<input name="moduleName" required maxlength="120" placeholder="Nom du module" /></label><label>Document recherché<input name="title" required maxlength="160" placeholder="Titre ou sujet du document" /></label><label>Type<select name="resourceType">{resourceTypes.map(t=><option>{t}</option>)}</select></label><label>Précisions<textarea name="details" rows="3" maxlength="1000" placeholder="Année, enseignant, chapitre…"></textarea></label><label>Contact (facultatif)<input name="contact" maxlength="160" placeholder="E-mail ou autre moyen de contact" /></label><p class="form-feedback" data-request-feedback role="status"></p><button class="primary-button" type="submit">Envoyer la demande</button><p class="privacy-note">Vos coordonnées sont facultatives et servent uniquement au suivi de cette demande.</p></form></dialog>
    </main>
    <footer class="footer"><a class="footer-brand" href={base}>FSBM Library<span>.</span></a><span>Une initiative de partage des ressources académiques.</span><span><a href={`${base}admin/`}>Espace administration</a> · Bêta</span></footer>
  </div>
  <script>
    const api = window.FSBM.api;
    const searchForm = document.querySelector<HTMLFormElement>('#search-form');
    const results = document.querySelector<HTMLDivElement>('#search-results');
    const fmt = (bytes:number) => bytes < 1048576 ? `${Math.max(1,Math.round(bytes/1024))} Ko` : `${(bytes/1048576).toFixed(1)} Mo`;
    searchForm?.addEventListener('submit', async (event) => {
      event.preventDefault(); if (!results) return; results.innerHTML='<p class="muted">Recherche en cours…</p>';
      const q=(document.querySelector<HTMLInputElement>('#search-query')?.value||'').trim(); const type=(document.querySelector<HTMLSelectElement>('#search-type')?.value||'');
      try { const response=await fetch(`${api}/api/resources?${new URLSearchParams({q,type})}`); if(!response.ok) throw new Error(); const data=await response.json() as {resources:Array<{id:string,title:string,type:string,module_name:string,semester_number:number,size_bytes:number,downloads:number,academic_year:string|null}>};
        results.replaceChildren(); if(!data.resources.length){results.innerHTML='<p class="muted">Aucune ressource publiée ne correspond à votre recherche.</p>';return;}
        for(const item of data.resources){const card=document.createElement('article');card.className='resource-card';const meta=document.createElement('div');meta.className='resource-meta';meta.textContent=`S${item.semester_number} · ${item.module_name} · ${item.type}`;const title=document.createElement('h3');title.textContent=item.title;const foot=document.createElement('div');foot.className='resource-foot';const size=document.createElement('span');size.textContent=`PDF · ${fmt(item.size_bytes)}${item.academic_year?` · ${item.academic_year}`:''}`;const link=document.createElement('a');link.className='download-link';link.href=`${api}/api/download/${encodeURIComponent(item.id)}`;link.textContent='Télécharger ↗';foot.append(size,link);card.append(meta,title,foot);results.append(card);}
      } catch {results.innerHTML='<p class="error-text">Le catalogue est momentanément indisponible. Réessayez plus tard.</p>';}
    });
    const dialog=document.querySelector<HTMLDialogElement>('#request-dialog'); document.querySelector('[data-open-request]')?.addEventListener('click',()=>dialog?.showModal()); document.querySelector('[data-close-dialog]')?.addEventListener('click',()=>dialog?.close());
    document.querySelector<HTMLFormElement>('#request-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;const feedback=form.querySelector<HTMLElement>('[data-request-feedback]');const button=form.querySelector<HTMLButtonElement>('button[type=submit]');if(feedback)feedback.textContent='Envoi en cours…';if(button)button.disabled=true;const payload=Object.fromEntries(new FormData(form).entries());try{const response=await fetch(`${api}/api/requests`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)});const data=await response.json() as {message?:string,error?:string};if(!response.ok)throw new Error(data.error||'Envoi impossible.');if(feedback)feedback.textContent=data.message||'Demande envoyée.';form.reset();}catch(error){if(feedback)feedback.textContent=error instanceof Error?error.message:'Une erreur est survenue.';}finally{if(button)button.disabled=false;}});
    fetch(`${api}/api/catalogue`).then(r=>r.ok?r.json():null).then(data=>{if(!data?.semesters)return;for(const s of data.semesters){const node=document.querySelector<HTMLElement>(`[data-semester-count="${s.number}"]`);if(node)node.textContent=`${s.module_count} module(s) · ${s.resource_count} ressource(s)`;}}).catch(()=>{});
  </script>
</BaseLayout>
