---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ThemeToggle from '../../../components/ThemeToggle.astro';
import { semesters, programme, resourceTypes } from '../../../data/catalogue';
export function getStaticPaths(){return semesters.map(semester=>({params:{semester:semester.id},props:{semester}}));}
const {semester}=Astro.props; const base=import.meta.env.BASE_URL;
---
<BaseLayout title={`${semester.label} — ${programme.name} | FSBM Library`}>
<div class="site-shell"><header class="topbar"><a class="brand" href={base}><span class="brand-mark">F<span>.</span></span><span class="brand-name">FSBM <strong>Library</strong><small>BIBLIOTHÈQUE UNIVERSITAIRE</small></span></a><nav class="top-nav"><a href={`${base}#semestres`}>Tous les semestres</a></nav><div class="top-actions"><ThemeToggle /><a class="back-link" href={base}>← Accueil</a></div></header>
<main class="semester-page" data-semester={semester.number}><div class="breadcrumb"><a href={base}>Accueil</a><span>/</span><span>{programme.name}</span><span>/</span><strong>{semester.label}</strong></div><div class="eyebrow">INFORMATIQUE APPLIQUÉE · {semester.id.toUpperCase()}</div><h1>{semester.label}<span>.</span></h1><p class="semester-intro">Les modules et ressources publiés pour ce semestre sont regroupés ci-dessous.</p>
<div class="semester-toolbar"><label>Filtrer par type<select id="semester-type"><option value="">Tous les types</option>{resourceTypes.map(t=><option>{t}</option>)}</select></label><label>Rechercher<input id="semester-query" type="search" placeholder="Nom du module ou document" /></label></div>
<div id="module-list" class="module-list" aria-live="polite"><p class="muted">Chargement du catalogue…</p></div></main><footer class="footer"><a class="footer-brand" href={base}>FSBM Library<span>.</span></a><span>Ressources académiques en accès libre</span><span><a href={`${base}admin/`}>Administration</a></span></footer></div>
<script>
const number=Number(document.querySelector<HTMLElement>('[data-semester]')?.dataset.semester);const api=window.FSBM.api;const target=document.querySelector<HTMLElement>('#module-list');let modules:Array<any>=[];let resources:Array<any>=[];
function render(){if(!target)return;const type=(document.querySelector<HTMLSelectElement>('#semester-type')?.value||'');const q=(document.querySelector<HTMLInputElement>('#semester-query')?.value||'').toLowerCase();target.replaceChildren();const visible=modules.filter(m=>m.name.toLowerCase().includes(q)||resources.some(r=>r.module_id===m.id&&r.title.toLowerCase().includes(q)));if(!visible.length){target.innerHTML='<div class="empty-state"><div class="empty-symbol">▤</div><h2>Aucun module publié</h2><p>Les modules et leurs ressources validés pour ce semestre apparaîtront ici. Vous pouvez demander l’ajout d’un document depuis la page d’accueil.</p><a class="text-link" href="'+window.FSBM.base+'#demande">Faire une demande →</a></div>';return;}for(const module of visible){const section=document.createElement('section');section.className='module-section';const heading=document.createElement('h2');heading.textContent=module.name+(module.code?` · ${module.code}`:'');section.append(heading);if(module.description){const desc=document.createElement('p');desc.className='muted';desc.textContent=module.description;section.append(desc);}const rows=resources.filter(r=>r.module_id===module.id&&(!type||r.type===type)&&(!q||r.title.toLowerCase().includes(q)||module.name.toLowerCase().includes(q)));if(!rows.length){const empty=document.createElement('p');empty.className='muted';empty.textContent='Aucune ressource publiée pour ce module.';section.append(empty);}for(const item of rows){const card=document.createElement('article');card.className='resource-card';const meta=document.createElement('div');meta.className='resource-meta';meta.textContent=item.type;const title=document.createElement('h3');title.textContent=item.title;const foot=document.createElement('div');foot.className='resource-foot';const size=document.createElement('span');size.textContent=`PDF · ${Math.round(item.size_bytes/1024)} Ko`;const link=document.createElement('a');link.className='download-link';link.href=`${api}/api/download/${encodeURIComponent(item.id)}`;link.textContent='Télécharger ↗';foot.append(size,link);card.append(meta,title,foot);section.append(card);}target.append(section);}}
async function load(){try{const [m,r]=await Promise.all([fetch(`${api}/api/modules?semester=${number}`),fetch(`${api}/api/resources?semester=${number}`)]);if(!m.ok||!r.ok)throw new Error();const md=await m.json();const rd=await r.json();modules=md.modules;resources=rd.resources;render();}catch{if(target)target.innerHTML='<p class="error-text">Impossible de charger le catalogue pour le moment.</p>';}}
document.querySelector('#semester-type')?.addEventListener('change',render);document.querySelector('#semester-query')?.addEventListener('input',render);load();
</script>
</BaseLayout>
