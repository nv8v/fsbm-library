---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="Administration — FSBM Library">
<div class="admin-shell"><header class="topbar"><a class="brand" href={base}><span class="brand-mark">F<span>.</span></span><span class="brand-name">FSBM <strong>Library</strong><small>ESPACE ADMINISTRATION</small></span></a><div class="top-actions"><ThemeToggle /><a class="back-link" href={base}>← Site public</a></div></header>
<main class="admin-main"><section id="login-panel" class="login-panel"><div class="eyebrow">ACCÈS SÉCURISÉ</div><h1>Administration<span>.</span></h1><p class="muted">Connectez-vous avec votre compte administrateur.</p><form id="login-form" class="stack-form"><label>Adresse e-mail<input name="email" type="email" autocomplete="username" required /></label><label>Mot de passe<input name="password" type="password" autocomplete="current-password" required /></label><p class="form-feedback" id="login-feedback" role="status"></p><button class="primary-button" type="submit">Se connecter</button></form></section>
<section id="dashboard" hidden><div class="admin-heading"><div><div class="eyebrow">ESPACE PRIVÉ</div><h1>Tableau de bord<span>.</span></h1><p id="admin-identity" class="muted"></p></div><button id="logout" class="outline-button">Déconnexion</button></div><div class="stats-grid"><article class="stat-card"><span>Ressources</span><strong id="stat-resources">—</strong></article><article class="stat-card"><span>Demandes à traiter</span><strong id="stat-requests">—</strong></article><article class="stat-card"><span>Modules</span><strong id="stat-modules">—</strong></article></div>
<div class="admin-tabs"><button class="tab-button active" data-tab="resources">Ressources</button><button class="tab-button" data-tab="modules">Modules</button><button class="tab-button" data-tab="requests">Demandes</button><button class="tab-button" data-tab="users" id="users-tab" hidden>Administrateurs</button></div>
<section class="admin-panel" data-panel="resources"><div class="panel-heading"><h2>Gérer les ressources</h2><button class="primary-button" id="new-resource">Ajouter une ressource</button></div><div id="resource-admin-list" class="admin-list"></div><form id="resource-form" class="editor-form" hidden><h3>Nouvelle ressource</h3><label>Module<select name="moduleId" id="resource-module" required></select></label><label>Titre<input name="title" required maxlength="160" /></label><label>Description<textarea name="description" rows="2"></textarea></label><label>Type<select name="type" required>{['Cours','Résumés','TD','TP','Examens','Corrigés','Projets','Autres'].map(t=><option>{t}</option>)}</select></label><label>Année universitaire<input name="academicYear" placeholder="2026–2027" /></label><label>Fichier PDF<input name="file" type="file" accept="application/pdf,.pdf" required /></label><p class="form-feedback" id="resource-feedback" role="status"></p><div class="form-actions"><button class="primary-button" type="submit">Créer et téléverser</button><button class="outline-button" type="button" data-cancel-resource>Annuler</button></div></form></section>
<section class="admin-panel" data-panel="modules" hidden><div class="panel-heading"><h2>Modules pédagogiques</h2><button class="primary-button" id="new-module">Ajouter un module</button></div><form id="module-form" class="editor-form" hidden><label>Semestre<select name="semesterId" required>{Array.from({length:6},(_,i)=><option value={`ia-s${i+1}`}>Semestre {i+1}</option>)}</select></label><label>Nom du module<input name="name" required /></label><label>Code (facultatif)<input name="code" /></label><label>Description<textarea name="description" rows="2"></textarea></label><p class="form-feedback" id="module-feedback"></p><button class="primary-button" type="submit">Enregistrer le module</button></form><div id="module-admin-list" class="admin-list"></div></section>
<section class="admin-panel" data-panel="requests" hidden><h2>Demandes des étudiants</h2><div id="request-admin-list" class="admin-list"></div></section>
<section class="admin-panel" data-panel="users" hidden><h2>Comptes administrateurs</h2><form id="user-form" class="editor-form"><label>E-mail<input name="email" type="email" required /></label><label>Mot de passe temporaire (14 caractères minimum)<input name="password" type="password" minlength="14" required /></label><label>Rôle<select name="role"><option value="editor">Éditeur</option><option value="owner">Propriétaire</option></select></label><p class="form-feedback" id="user-feedback"></p><button class="primary-button" type="submit">Créer le compte</button></form><div id="user-admin-list" class="admin-list"></div></section>
</section></main><footer class="footer admin-footer"><a class="footer-brand" href={base}>FSBM Library<span>.</span></a><span>Console d’administration sécurisée</span></footer></div>
<script>
const api=window.FSBM.api;const $=<T extends HTMLElement>(selector:string)=>document.querySelector<T>(selector);let role='editor';let modules:Array<any>=[];
async function call(path:string,options:RequestInit={}){const response=await fetch(`${api}${path}`,{...options,credentials:'include',headers:{...(options.body?{'content-type':'application/json'}:{}),...options.headers}});const data=await response.json().catch(()=>({}));if(!response.ok)throw new Error(data.error||'Une erreur est survenue.');return data;}
function message(selector:string,text:string){const el=$(selector);if(el)el.textContent=text;}
async function enter(){const data=await call('/api/admin/me');role=data.admin.role;$<HTMLElement>('#login-panel')!.hidden=true;$<HTMLElement>('#dashboard')!.hidden=false;message('#admin-identity',`${data.admin.email} · ${role==='owner'?'Propriétaire':'Éditeur'}`);$<HTMLElement>('#users-tab')!.hidden=role!=='owner';await Promise.all([overview(),loadModules(),loadResources(),loadRequests()]);}
async function overview(){const d=await call('/api/admin/overview');message('#stat-resources',String(d.resources));message('#stat-requests',String(d.newRequests));message('#stat-modules',String(d.modules));}
async function loadModules(){const d=await call('/api/admin/modules');modules=d.modules;const list=$<HTMLElement>('#module-admin-list')!;list.replaceChildren();const select=$<HTMLSelectElement>('#resource-module')!;select.replaceChildren();for(const m of modules){const option=document.createElement('option');option.value=m.id;option.textContent=`S${m.semester_number} · ${m.name}`;select.append(option);const row=document.createElement('div');row.className='admin-row';const name=document.createElement('strong');name.textContent=`S${m.semester_number} · ${m.name}`;const code=document.createElement('span');code.textContent=m.code||'Sans code';row.append(name,code);list.append(row);}}
async function loadResources(){const d=await call('/api/admin/resources');const list=$<HTMLElement>('#resource-admin-list')!;list.replaceChildren();for(const r of d.resources){const row=document.createElement('div');row.className='admin-row';const info=document.createElement('div');const title=document.createElement('strong');title.textContent=r.title;const sub=document.createElement('small');sub.textContent=`S${r.semester_number} · ${r.module_name} · ${r.type}`;info.append(title,sub);const actions=document.createElement('div');actions.className='row-actions';const status=document.createElement('span');status.textContent=`${Math.round(r.size_bytes/1024)} Ko`;const publish=document.createElement('button');publish.className='small-button';publish.textContent='Archiver';publish.addEventListener('click',()=>updateResource(r.id,{status:'archived'}));const live=document.createElement('button');live.className='small-button';live.textContent='Publier';live.addEventListener('click',()=>updateResource(r.id,{status:'published'}));actions.append(status,live,publish);if(role==='owner'){const del=document.createElement('button');del.className='small-button danger-button';del.textContent='Supprimer';del.addEventListener('click',async()=>{if(confirm('Supprimer définitivement cette ressource et son fichier ?')){await call(`/api/admin/resources/${r.id}`,{method:'DELETE'});await loadResources();await overview();}});actions.append(del);}row.append(info,actions);list.append(row);}}
async function updateResource(id:string,body:unknown){try{await call(`/api/admin/resources/${id}`,{method:'PUT',body:JSON.stringify(body)});await loadResources();}catch(e){alert((e as Error).message);}}
async function loadRequests(){const d=await call('/api/admin/requests');const list=$<HTMLElement>('#request-admin-list')!;list.replaceChildren();for(const r of d.requests){const row=document.createElement('div');row.className='admin-row request-row';const info=document.createElement('div');const title=document.createElement('strong');title.textContent=r.title;const sub=document.createElement('small');sub.textContent=`${r.module_name} · ${r.resource_type} · ${r.semester_number?`S${r.semester_number}`:'Semestre non précisé'} · ${r.contact||'Sans contact'}`;const details=document.createElement('p');details.textContent=r.details||'';info.append(title,sub,details);const select=document.createElement('select');select.setAttribute('aria-label','Statut de la demande');for(const [value,label] of [['new','Nouvelle'],['in_progress','En cours'],['completed','Traitée'],['rejected','Refusée']]){const option=document.createElement('option');option.value=value;option.textContent=label;select.append(option);}select.value=r.status;select.addEventListener('change',async()=>{await call(`/api/admin/requests/${r.id}`,{method:'PUT',body:JSON.stringify({status:select.value})});await overview();});row.append(info,select);list.append(row);}}
async function loadUsers(){const d=await call('/api/admin/users');const list=$<HTMLElement>('#user-admin-list')!;list.replaceChildren();for(const u of d.users){const row=document.createElement('div');row.className='admin-row';const info=document.createElement('strong');info.textContent=u.email;const meta=document.createElement('span');meta.textContent=u.role==='owner'?'Propriétaire':'Éditeur';row.append(info,meta);list.append(row);}}
$('#login-form')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const body=Object.fromEntries(new FormData(form).entries());try{await call('/api/admin/login',{method:'POST',body:JSON.stringify(body)});await enter();}catch(err){message('#login-feedback',(err as Error).message);}});
$('#logout')?.addEventListener('click',async()=>{await call('/api/admin/logout',{method:'POST'});location.reload();});
document.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-tab]').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelectorAll<HTMLElement>('[data-panel]').forEach(p=>p.hidden=p.dataset.panel!==b.dataset.tab);if(b.dataset.tab==='users')loadUsers();}));
$('#new-resource')?.addEventListener('click',()=>{$<HTMLFormElement>('#resource-form')!.hidden=false;});$('[data-cancel-resource]')?.addEventListener('click',()=>{$<HTMLFormElement>('#resource-form')!.hidden=true;});
$('#resource-form')?.addEventListener('submit',async e=>{e.preventDefault();const form=e.currentTarget as HTMLFormElement;const data=new FormData(form);const file=data.get('file') as File;try{message('#resource-feedback','Création de la ressource…');const created=await call('/api/admin/resources',{method:'POST',body:JSON.stringify({moduleId:data.get('moduleId'),title:data.get('title'),description:data.get('description'),type:data.get('type'),academicYear:data.get('academicYear')})});message('#resource-feedback','Téléversement sécurisé du PDF…');const upload=await fetch(`${api}/api/admin/resources/${created.id}/file?filename=${encodeURIComponent(file.name)}`,{method:'PUT',credentials:'include',headers:{'content-type':'application/pdf'},body:file});const result=await upload.json();if(!upload.ok)throw new Error(result.error||'Téléversement impossible.');message('#resource-feedback','PDF ajouté. La ressource est en brouillon : publiez-la depuis la liste.');form.reset();await loadResources();await overview();}catch(err){message('#resource-feedback',(err as Error).message);}});
$('#new-module')?.addEventListener('click',()=>{$<HTMLFormElement>('#module-form')!.hidden=false;});$('#module-form')?.addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.currentTarget as HTMLFormElement).entries());try{await call('/api/admin/modules',{method:'POST',body:JSON.stringify(data)});message('#module-feedback','Module ajouté.');await loadModules();await overview();}catch(err){message('#module-feedback',(err as Error).message);}});
$('#user-form')?.addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.currentTarget as HTMLFormElement).entries());try{await call('/api/admin/users',{method:'POST',body:JSON.stringify(data)});message('#user-feedback','Compte créé.');(e.currentTarget as HTMLFormElement).reset();await loadUsers();}catch(err){message('#user-feedback',(err as Error).message);}});
enter().catch(()=>{});
</script>
</BaseLayout>
